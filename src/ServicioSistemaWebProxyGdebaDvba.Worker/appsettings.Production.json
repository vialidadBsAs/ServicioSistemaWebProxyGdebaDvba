{
  "ProxyGdebaLogin": "LoginProd",
  "ConnectionStrings": {
    "ProxyGdeba": "Server=SI-DB-01;Database=ServicioSistemaWebProxyGdebaDvba;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "Gdeba": {
    "CurrentEnvironment": "PROD",
    "GatewayMode": "Soap"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Query": "Error",
        "System.Net.Http.HttpClient": "Warning",
        "ServicioSistemaWebProxyGdebaDvba.Infrastructure.Gdeba.SoapGdebaExpedienteGateway": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
