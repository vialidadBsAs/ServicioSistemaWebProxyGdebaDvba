<?xml version="1.0" encoding="utf-8"?>
<!--
Publicacion a carpeta para IIS en SI-INTRAVIAL (Default Web Site/apps/Expedientes/ServicioSistemaWebProxyGdebaDvba).
El contenido de la carpeta se copia a la ruta fisica de la aplicacion IIS.
Ver docs/13-publicacion-iis.md.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishUrl>..\..\publish\Api</PublishUrl>
    <PublishDir>..\..\publish\Api</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
  </PropertyGroup>
</Project>
