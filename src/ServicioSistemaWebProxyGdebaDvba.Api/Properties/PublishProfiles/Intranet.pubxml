<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://intranet.vialidad.gba.gov.ar/apps/expedientes/ServicioSistemaWebProxyGdebaDvba</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>b7e5af01-04fd-4ba1-931a-c9a0d89ffd69</ProjectGuid>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>http://intranet.vialidad.gba.gov.ar</MSDeployServiceURL>
    <DeployIisAppPath>Default Web Site/apps/expedientes/ServicioSistemaWebProxyGdebaDvba</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>RemoteAgent</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>VIALIDAD\administrador</UserName>
    <_SavePWD>true</_SavePWD>
    <_TargetId>IISWebDeploy</_TargetId>
  </PropertyGroup>
</Project>